<!doctype html>
<html lang="en">
  <body style="margin:0;padding:24px;background-color:#f3f6f4;font-family:Arial,Helvetica,sans-serif;color:#172b24;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:600px;margin:0 auto;background-color:#ffffff;border-collapse:collapse;">
      <tr><td style="padding:24px 28px;background-color:#145b45;color:#ffffff;font-size:20px;font-weight:bold;">CosmosVote</td></tr>
      <tr><td style="padding:28px;">
        <p style="margin:0 0 8px;color:#33745d;font-size:13px;font-weight:bold;text-transform:uppercase;">{{eventName}}</p>
        <h1 style="margin:0 0 16px;font-size:24px;line-height:1.3;">{{title}}</h1>
        <p style="margin:0 0 20px;font-size:16px;line-height:1.5;">{{result}}</p>
        {{#if proposalLink}}<p style="margin:0 0 20px;"><a href="{{proposalLink}}" style="display:inline-block;padding:12px 18px;background-color:#145b45;color:#ffffff;text-decoration:none;">View proposal</a></p>{{/if}}
        <p style="margin:0;color:#596861;font-size:13px;">Proposal {{proposalId}} · Ledger {{ledger}}</p>
      </td></tr>
    </table>
  </body>
</html>